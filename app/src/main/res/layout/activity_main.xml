<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lunar_space_black">

    <!-- VR Rendering Container -->
    <FrameLayout
        android:id="@+id/vr_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/vr_surface_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- First Run / Welcome Splash Screen -->
    <LinearLayout
        android:id="@+id/splash_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@color/lunar_space_black">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_lunar_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/lunar_accent"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lunar_tagline"
            android:textColor="@color/lunar_dim_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_sensor_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Detectando sensores do aparelho..."
            android:textAlignment="center"
            android:textColor="@color/lunar_silver"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btn_start_vr"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/start_vr"
            android:textColor="@color/lunar_space_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/lunar_accent" />

    </LinearLayout>

</FrameLayout>
